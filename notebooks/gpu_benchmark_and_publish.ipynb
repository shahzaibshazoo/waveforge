   "source": [
    "# WaveForge — GPU Benchmark & Auto-Publish\n",
    "\n",
    "This notebook:\n",
    "1. Runs WaveForge on the **real T4 GPU** — measures actual throughput\n",
    "2. Loads pre-measured CPU results from the repo (`benchmarks/cpu_results.json`)\n",
    "3. Generates a combined comparison chart with **both real GPU and CPU numbers**\n",
    "4. Commits the chart back to GitHub automatically\n",
    "\n",
    "> **Setup:** Runtime → Change runtime type → **T4 GPU** → Run all cells"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Check GPU\n",
    "import subprocess\n",
    "r = subprocess.run(['nvidia-smi', '--query-gpu=name,memory.total,driver_version',\n",
    "                    '--format=csv,noheader'], capture_output=True, text=True)\n",
    "if r.returncode == 0:\n",
    "    gpu_info = r.stdout.strip()\n",
    "    print(f'GPU: {gpu_info}')\n",
    "else:\n",
    "    print('WARNING: No GPU. Go to Runtime → Change runtime type → T4 GPU')\n",
    "    gpu_info = 'No GPU'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Clone repo and install\n",
    "!git clone https://github.com/shahzaibshazoo/cuda-meep.git\n",
    "!pip install torch numpy matplotlib --quiet"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Setup\n",
    "import sys, time, json\n",
    "import numpy as np\n",
    "sys.path.insert(0, '/content/cuda-meep/src')\n",
    "import torch\n",
    "\n",
    "DEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "GPU_NAME = torch.cuda.get_device_name(0) if DEVICE == 'cuda' else 'CPU'\n",
    "print(f'PyTorch {torch.__version__}')\n",
    "print(f'Device: {DEVICE} — {GPU_NAME}')\n",
    "if DEVICE == 'cuda':\n",
    "    vram = torch.cuda.get_device_properties(0).total_memory / 1e9\n",
    "    print(f'VRAM: {vram:.1f} GB')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Run WaveForge GPU benchmark\n",
    "from core import YeeGrid, FieldSet, MurABC, GaussianPulse, PointSource, SourceCollection, FDTD2D\n",
    "\n",
    "GRID_SIZES = [64, 128, 256, 512]\n",
    "N_WARMUP   = 30    # more warmup for accurate GPU measurement\n",
    "N_STEPS    = 300   # more steps for stable average\n",
    "DX         = 1e-3\n",
    "\n",
    "def bench_waveforge(N, device, n_warmup=N_WARMUP, n_steps=N_STEPS):\n",
    "    grid     = YeeGrid(N, N, dx=DX, dy=DX, device=device)\n",
    "    fields   = FieldSet(grid)\n",
    "    boundary = MurABC(grid, fields.Hz)\n",
    "    pulse    = GaussianPulse(amplitude=1.0, sigma=30*grid.dt)\n",
    "    src      = PointSource(pulse, N//2, N//2, 'Hz', grid=grid, N_steps=n_warmup+n_steps)\n",
    "    sim      = FDTD2D(grid, fields, boundary, SourceCollection([src]), n_check=1000)\n",
    "    sim.run(n_warmup)   # warmup — JIT + GPU kernel cache\n",
    "    if device == 'cuda': torch.cuda.synchronize()\n",
    "    t0 = time.perf_counter()\n",
    "    sim.run(n_steps)\n",
    "    if device == 'cuda': torch.cuda.synchronize()\n",
    "    elapsed = time.perf_counter() - t0\n",
    "    return n_steps * N * N / elapsed / 1e6, elapsed / n_steps * 1000\n",
    "\n",
    "gpu_results = []\n",
    "print(f'--- WaveForge GPU ({GPU_NAME}) ---')\n",
    "for N in GRID_SIZES:\n",
    "    m, ms = bench_waveforge(N, DEVICE)\n",
    "    gpu_results.append({'N': N, 'mcells_s': round(m, 2), 'ms_step': round(ms, 4)})\n",
    "    print(f'  {N:4d}²   {m:8.1f} Mcells/s   {ms:8.3f} ms/step')\n",
    "\n",
    "print(f'\\nGPU benchmark complete!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 5: Load pre-measured CPU results\n",
    "import json\n",
    "cpu_path = '/content/cuda-meep/benchmarks/cpu_results.json'\n",
    "with open(cpu_path) as f:\n",
    "    cpu_data = json.load(f)\n",
    "\n",
    "# Handle both old key name (cuda_meep_cpu) and new (waveforge_cpu)\n",
    "cpu_key = 'waveforge_cpu' if 'waveforge_cpu' in cpu_data else 'cuda_meep_cpu'\n",
    "waveforge_cpu = cpu_data[cpu_key]\n",
    "meep_cpu      = cpu_data['meep_cpu']\n",
    "\n",
    "print(f'CPU results loaded from: {cpu_path}')\n",
    "print(f'Measured on: {cpu_data[\"meta\"][\"date\"][:10]}')\n",
    "print()\n",
    "print('--- WaveForge CPU (pre-measured) ---')\n",
    "for r in waveforge_cpu:\n",
    "    print(f'  {r[\"N\"]:4d}²   {r[\"mcells_s\"]:8.1f} Mcells/s')\n",
    "print('--- Meep CPU (pre-measured) ---')\n",
    "for r in meep_cpu:\n",
    "    print(f'  {r[\"N\"]:4d}²   {r[\"mcells_s\"]:8.1f} Mcells/s')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 6: Full results table\n",
    "print('='*75)\n",
    "print(f'  {\"Grid\":5s}  {\"WaveForge GPU\":>16s}  {\"WaveForge CPU\":>15s}  {\"Meep CPU\":>12s}  {\"GPU/Meep\":>10s}')\n",
    "print(f'  {\"\":5s}  {GPU_NAME[:16]:>16s}  {\"(laptop)\": >15s}  {\"(laptop)\": >12s}')\n",
    "print('='*75)\n",
    "for i, N in enumerate(GRID_SIZES):\n",
    "    gpu  = gpu_results[i]['mcells_s']\n",
    "    cpu  = waveforge_cpu[i]['mcells_s']\n",
    "    meep = meep_cpu[i]['mcells_s']\n",
    "    spd  = f'{gpu/meep:.1f}x'\n",
    "    print(f'  {N}²    {gpu:>14.1f}  {cpu:>13.1f}  {meep:>10.1f}  {spd:>10s}')\n",
    "print('='*75)\n",
    "large = [i for i,N in enumerate(GRID_SIZES) if N >= 256]\n",
    "avg_speedup = sum(gpu_results[i]['mcells_s']/meep_cpu[i]['mcells_s'] for i in large)/len(large)\n",
    "print(f'\\nAverage GPU speedup over Meep at 256²+: {avg_speedup:.1f}x (REAL MEASURED)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 7: Generate chart with REAL measured numbers\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(15, 6))\n",
    "fig.suptitle(f'WaveForge vs Meep — REAL Benchmark ({GPU_NAME})',\n",
    "             fontsize=13, fontweight='bold')\n",
    "\n",
    "gpu_mc  = [r['mcells_s'] for r in gpu_results]\n",
    "cpu_mc  = [r['mcells_s'] for r in waveforge_cpu]\n",
    "meep_mc = [r['mcells_s'] for r in meep_cpu]\n",
    "speedups_meep = [g/m for g,m in zip(gpu_mc, meep_mc)]\n",
    "speedups_cpu  = [g/c for g,c in zip(gpu_mc, cpu_mc)]\n",
    "\n",
    "ax = axes[0]\n",
    "ax.plot(GRID_SIZES, gpu_mc,  'o-', color='#2ca02c', lw=2.5, ms=9,\n",
    "        label=f'WaveForge GPU ({GPU_NAME})')\n",
    "ax.plot(GRID_SIZES, cpu_mc,  's-', color='steelblue', lw=2, ms=8,\n",
    "        label='WaveForge CPU (laptop)')\n",
    "ax.plot(GRID_SIZES, meep_mc, '^-', color='#d62728', lw=2, ms=8,\n",
    "        label='Meep CPU (laptop)')\n",
    "\n",
    "# Annotate peak GPU value\n",
    "peak_idx = gpu_mc.index(max(gpu_mc))\n",
    "ax.annotate(f'{gpu_mc[peak_idx]:.0f} Mcells/s',\n",
    "            (GRID_SIZES[peak_idx], gpu_mc[peak_idx]),\n",
    "            textcoords='offset points', xytext=(5, 10),\n",
    "            fontsize=10, color='#2ca02c', fontweight='bold')\n",
    "\n",
    "ax.set(xlabel='Grid size', ylabel='Throughput (Mcells/s)',\n",
    "       title='Real Measured Throughput')\n",
    "ax.set_xticks(GRID_SIZES); ax.set_xticklabels([f'{N}²' for N in GRID_SIZES])\n",
    "ax.legend(fontsize=9); ax.grid(True, alpha=0.3)\n",
    "\n",
    "# Speedup bars\n",
    "ax2 = axes[1]\n",
    "x = range(len(GRID_SIZES)); w = 0.35\n",
    "colors_m = ['#d62728' if s<1 else '#2ca02c' for s in speedups_meep]\n",
    "colors_c = ['#d62728' if s<1 else 'steelblue' for s in speedups_cpu]\n",
    "b1 = ax2.bar([i-w/2 for i in x], speedups_meep, w, color=colors_m, alpha=0.85, label='vs Meep')\n",
    "b2 = ax2.bar([i+w/2 for i in x], speedups_cpu,  w, color=colors_c, alpha=0.85, label='vs WaveForge CPU')\n",
    "ax2.bar_label(b1, [f'{s:.1f}x' for s in speedups_meep], fontsize=11, padding=3)\n",
    "ax2.bar_label(b2, [f'{s:.1f}x' for s in speedups_cpu],  fontsize=11, padding=3)\n",
    "ax2.axhline(1, color='black', ls='--', alpha=0.3)\n",
    "ax2.set(ylabel='Speedup', title=f'Real GPU Speedup ({GPU_NAME})')\n",
    "ax2.set_xticks(list(x)); ax2.set_xticklabels([f'{N}²' for N in GRID_SIZES])\n",
    "ax2.legend(fontsize=9); ax2.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "plt.tight_layout()\n",
    "out_path = '/content/benchmark_real_gpu.png'\n",
    "fig.savefig(out_path, dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(f'Chart saved: {out_path}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 8: Save results JSON\n",
    "import datetime, platform\n",
    "\n",
    "results = {\n",
    "    'meta': {\n",
    "        'date':     datetime.datetime.now().isoformat(),\n",
    "        'gpu':      GPU_NAME,\n",
    "        'platform': 'Google Colab',\n",
    "        'torch':    torch.__version__,\n",
    "        'n_warmup': N_WARMUP,\n",
    "        'n_steps':  N_STEPS,\n",
    "        'dx_mm':    DX * 1e3,\n",
    "        'measured': True,   # flag: these are REAL numbers, not estimates\n",
    "    },\n",
    "    'waveforge_gpu': gpu_results,\n",
    "    'waveforge_cpu': waveforge_cpu,\n",
    "    'meep_cpu':      meep_cpu,\n",
    "    'speedup_vs_meep': {str(N): round(g/m, 2)\n",
    "                        for N,g,m in zip(GRID_SIZES, gpu_mc, meep_mc)},\n",
    "}\n",
    "\n",
    "json_path = '/content/cuda-meep/benchmarks/gpu_results.json'\n",
    "with open(json_path, 'w') as f:\n",
    "    json.dump(results, f, indent=2)\n",
    "print(f'Results saved: {json_path}')\n",
    "print(json.dumps(results['speedup_vs_meep'], indent=2))"
   ]
  },
  {
